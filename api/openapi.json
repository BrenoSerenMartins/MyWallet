  "info": {
    "title": "MyWallet API",
    "description": "",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "AccountResourceDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "institution": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "openingBalance": {
            "type": "number"
          },
          "openingDate": {
            "type": "string"
          },
          "balance": {
            "type": "number"
          },
          "version": {
            "type": "number"
          },
          "archived": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "institution",
          "type",
          "currency",
          "openingBalance",
          "openingDate",
          "balance",
          "version",
          "archived"
        ]
      },
      "CreateAccountDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "institution": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": ["checking", "savings", "cash", "reserve"]
          },
          "openingBalance": {
            "type": "number"
          },
          "openingDate": {
            "type": "string"
          }
        },
        "required": ["name", "institution", "type", "openingBalance", "openingDate"]
      },
      "CategoryResourceDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "color": {
            "type": "string"
          }
        },
        "required": ["id", "name", "type", "color"]
      },
      "CategoryDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": ["income", "expense"]
          },
          "color": {
            "type": "string"
          }
        },
        "required": ["name", "type", "color"]
      },
      "TransactionResourceDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "accountId": {
            "type": "string"
          },
          "categoryId": {
            "type": "string",
            "nullable": true
          },
          "transactionDate": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          },
          "transactionType": {
            "type": "string",
            "enum": ["income", "expense", "transfer", "unclassified"]
          },
          "version": {
            "type": "number"
          },
          "importBatchId": {
            "type": "string",
            "nullable": true
          },
          "transferGroupId": {
            "type": "string",
            "nullable": true
          },
          "brand": {
            "type": "string",
            "nullable": true
          },
          "installments": {
            "type": "number",
            "nullable": true
          },
          "installmentNumber": {
            "type": "number",
            "nullable": true
          },
          "merchant": {
            "type": "string",
            "nullable": true
          },
          "counterparty": {
            "type": "string",
            "nullable": true
          },
          "sourceOperationId": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "accountId",
          "categoryId",
          "transactionDate",
          "description",
          "amount",
          "transactionType",
          "version",
          "importBatchId",
          "transferGroupId",
          "brand",
          "installments",
          "installmentNumber",
          "merchant",
          "counterparty",
          "sourceOperationId"
        ]
      },
      "TransactionCollectionDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TransactionResourceDto"
            }
          },
          "nextCursor": {
            "type": "string",
            "nullable": true
          }
        },
        "required": ["items", "nextCursor"]
      },
      "TransactionDto": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string"
          },
          "categoryId": {
            "type": "string"
          },
          "transactionDate": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          },
          "transactionType": {
            "type": "string",
            "enum": ["income", "expense"]
          }
        },
        "required": ["accountId", "transactionDate", "description", "amount", "transactionType"]
      },
      "TransferDto": {
        "type": "object",
        "properties": {
          "fromAccountId": {
            "type": "string"
          },
          "toAccountId": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          },
          "transactionDate": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
