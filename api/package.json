{
  "name": "@mywallet/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../.env.local src/main.ts",
    "build": "tsc -p tsconfig.build.json && node ../scripts/copy-api-assets.mjs",
    "typecheck": "tsc --noEmit",
    "start": "node --env-file-if-exists=../.env.local dist/main.js",
    "openapi": "node --import tsx src/core/openapi/export.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/platform-express": "^12.0.0",
    "@nestjs/swagger": "^12.0.0",
    "@supabase/supabase-js": "^2.110.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.0",
    "helmet": "^8.0.0",
    "pdfjs-dist": "6.4.299",
    "pg": "^8.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/pg": "^8.0.0",
    "@types/supertest": "^6.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.0.0"
  }
}
